{
  "name": "inspiration-wall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm build && pnpm exec wrangler pages dev dist",
    "build": "vite build",
    "test": "node tests/cloud.test.mjs && node tests/density.test.mjs",
    "db:local": "wrangler d1 execute inspiration-wall --local --file cloud/schema.sql",
    "db:remote": "wrangler d1 execute inspiration-wall --remote --file cloud/schema.sql",
    "deploy": "pnpm build && wrangler pages deploy dist"
  },
  "dependencies": {
    "lucide-react": "1.62.0",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.156.0"
  },
  "packageManager": "pnpm@11.25.0",
  "license": "MIT",
  "description": "扫码填卡、自动上墙的互动灵感墙模板"
}
